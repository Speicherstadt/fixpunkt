{
  "fileSize": {
    "include": ["ui/src/**/*.{ts,tsx}", "crates/*/src/**/*.rs"]
  },
  "pages": {
    "routeTree": "ui/src/routeTree.gen.ts",
    "specs": ["e2e/accessibility.spec.ts"]
  },
  "i18n": {
    "project": "ui/project.inlang",
    "include": ["ui/src/**/*.{ts,tsx}"],
    "dynamicPrefixes": ["server_"]
  },
  "cycles": {
    "modules": ["ui/src/components/*", "ui/src/*"],
    "aliases": {
      "@/": "ui/src/"
    }
  }
}
